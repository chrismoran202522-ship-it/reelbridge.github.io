                tbody.innerHTML = users.map(user => `
                    <tr>
                        <td>${user.email}</td>
                        <td>${user.business_name || '-'}</td>
                        <td>${user.package}</td>
                        <td>${user.posts_used}/${user.posts_used + user.posts_remaining}</td>
                        <td>
                            <span class="status-badge ${user.is_active ? 'status-active' : user.status === 'pending' ? 'status-pending' : 'status-suspended'}">
                                ${user.is_active ? 'Active' : user.status === 'pending' ? 'Pending' : 'Suspended'}
                            </span>
                        </td>
                        <td>${new Date(user.created_at).toLocaleDateString()}</td>
                        <td>
                            <button class="action-btn btn-edit" onclick="openAdminEdit(${user.id})">
                                Edit
                            </button>
                            <button class="action-btn ${user.is_active ? 'btn-suspend' : 'btn-activate'}" 
                                    onclick="toggleUserStatus(${user.id}, ${!user.is_active})">
                                ${user.is_active ? 'Suspend' : 'Activate'}
                            </button>
                        </td>
                    </tr>
                `).join('');
                
                // Load activity
                const activityDiv = document.getElementById('adminActivity');
                activityDiv.innerHTML = stats.recentActivity.map(log => `
                    <div style="padding:

